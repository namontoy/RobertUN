# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

# Otros elementos a ignorar
git_ignored/

# KiCad per-user project preferences — window positions, last-opened view.
# Local state, not design data; it churns every time the project is opened.
*.kicad_prl

# Project-context export archive
project-context.zip

# Python bytecode from the figure and bench scripts
__pycache__/
*.pyc

# Bench run data. Everything a run produces is raw instrument output - the
# .csv rows, the console transcript, the meta/status dumps - and it is INPUT to
# the figure scripts, not a record anyone reads. It stays on the bench machine;
# what the repo keeps is the figure and the numbers quoted in the docs. Never
# `git add -f` one: if a result matters, it belongs in a figure and in
# PROJECT_CONTEXT, not as a blob. (No blanket *.json here - CMakePresets.json
# and .vscode/ are real repo files; the run .json is covered by runs/ in
# firmware/RobertUN_ModuleNode/tools/bench/.gitignore.)
*.csv
*.log
